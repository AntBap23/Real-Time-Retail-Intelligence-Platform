{
  "name": "ml_training_workflow",
  "description": "Machine Learning Training and Model Deployment Workflow",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "schedule": {
    "quartz_cron_expression": "0 0 0 * * SUN",
    "timezone_id": "UTC"
  },
  "tasks": [
    {
      "task_key": "data_preparation",
      "description": "Prepare data for machine learning models",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "data_preparation",
          "environment": "production"
        }
      },
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "sales_forecasting_model",
      "description": "Train sales forecasting model",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "sales_forecasting",
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "data_preparation"
        }
      ],
      "timeout_seconds": 3600,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "customer_segmentation_model",
      "description": "Train customer segmentation model",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "customer_segmentation",
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "data_preparation"
        }
      ],
      "timeout_seconds": 3600,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "product_recommendation_model",
      "description": "Train product recommendation model",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "product_recommendation",
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "data_preparation"
        }
      ],
      "timeout_seconds": 3600,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "model_evaluation",
      "description": "Evaluate all trained models",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "model_evaluation",
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "sales_forecasting_model"
        },
        {
          "task_key": "customer_segmentation_model"
        },
        {
          "task_key": "product_recommendation_model"
        }
      ],
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "model_deployment",
      "description": "Deploy best performing models",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "model_deployment",
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "model_evaluation"
        }
      ],
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "model_monitoring",
      "description": "Set up model monitoring and alerts",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/05_ml_pipeline",
        "base_parameters": {
          "step": "model_monitoring",
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "model_deployment"
        }
      ],
      "timeout_seconds": 900,
      "retry_on_timeout": true,
      "max_retries": 1
    },
    {
      "task_key": "send_ml_notification",
      "description": "Send ML training completion notification",
      "email_notifications": {
        "on_success": [
          "ml-team@retailintelligence.com"
        ],
        "on_failure": [
          "ml-team@retailintelligence.com",
          "data-team@retailintelligence.com"
        ]
      },
      "depends_on": [
        {
          "task_key": "model_monitoring"
        }
      ]
    }
  ],
  "email_notifications": {
    "on_start": [
      "ml-team@retailintelligence.com"
    ],
    "on_success": [
      "ml-team@retailintelligence.com"
    ],
    "on_failure": [
      "ml-team@retailintelligence.com",
      "data-team@retailintelligence.com"
    ]
  },
  "webhook_notifications": {
    "on_success": {
      "id": "slack-ml-success-webhook"
    },
    "on_failure": {
      "id": "slack-ml-failure-webhook"
    }
  },
  "access_control_list": [
    {
      "user_name": "ml-lead@retailintelligence.com",
      "permission_level": "CAN_MANAGE"
    },
    {
      "group_name": "ml-team",
      "permission_level": "CAN_RUN"
    }
  ],
  "run_as": {
    "service_principal_name": "retail-ml-sp@retailintelligence.com"
  },
  "git_source": {
    "git_url": "https://github.com/retailintelligence/databricks-workflows.git",
    "git_branch": "main",
    "git_provider": "gitHub"
  },
  "parameters": [
    {
      "name": "environment",
      "default": "production"
    },
    {
      "name": "model_version",
      "default": "latest"
    },
    {
      "name": "training_data_path",
      "default": "/mnt/dbfs/retail_data/delta/gold"
    }
  ],
  "tags": {
    "environment": "production",
    "team": "machine-learning",
    "project": "retail-intelligence",
    "cost-center": "analytics"
  },
  "cluster_spec": {
    "new_cluster": {
      "cluster_name": "retail-ml-cluster",
      "spark_version": "13.3.x-scala2.12",
      "node_type_id": "i3.xlarge",
      "driver_node_type_id": "i3.xlarge",
      "num_workers": 2,
      "autoscale": {
        "min_workers": 1,
        "max_workers": 4
      },
      "spark_conf": {
        "spark.sql.extensions": "io.delta.sql.DeltaSparkSessionExtension",
        "spark.sql.catalog.spark_catalog": "org.apache.spark.sql.delta.catalog.DeltaCatalog",
        "spark.databricks.delta.optimizeWrite.enabled": "true",
        "spark.databricks.delta.autoCompact.enabled": "true",
        "spark.sql.adaptive.enabled": "true",
        "spark.sql.adaptive.coalescePartitions.enabled": "true"
      },
      "custom_tags": {
        "environment": "production",
        "team": "machine-learning"
      }
    }
  }
}
