{
  "name": "retail_etl_workflow",
  "description": "Retail Intelligence Platform ETL Workflow",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "schedule": {
    "quartz_cron_expression": "0 0 * * * ?",
    "timezone_id": "UTC"
  },
  "tasks": [
    {
      "task_key": "data_ingestion",
      "description": "Ingest data from various sources into Bronze tables",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/01_data_ingestion",
        "base_parameters": {
          "environment": "production"
        }
      },
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2,
      "retry_on_timeout": true
    },
    {
      "task_key": "data_cleaning",
      "description": "Clean and validate data from Bronze to Silver tables",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/02_data_cleaning",
        "base_parameters": {
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "data_ingestion"
        }
      ],
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "delta_lake_setup",
      "description": "Create Gold tables with business logic and aggregations",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/03_delta_lake_setup",
        "base_parameters": {
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "data_cleaning"
        }
      ],
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "mongodb_integration",
      "description": "Integrate MongoDB Atlas with Databricks for semi-structured data",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/04_mongodb_integration",
        "base_parameters": {
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "delta_lake_setup"
        }
      ],
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "dbt_transformations",
      "description": "Run dbt transformations for additional business logic",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/databricks/notebooks/06_dbt_transformations",
        "base_parameters": {
          "environment": "production"
        }
      },
      "depends_on": [
        {
          "task_key": "mongodb_integration"
        }
      ],
      "timeout_seconds": 1800,
      "retry_on_timeout": true,
      "max_retries": 2
    },
    {
      "task_key": "data_quality_checks",
      "description": "Run comprehensive data quality checks",
      "python_wheel_task": {
        "package_name": "data_quality",
        "entry_point": "main",
        "parameters": [
          "--environment", "production",
          "--check-type", "all"
        ]
      },
      "depends_on": [
        {
          "task_key": "dbt_transformations"
        }
      ],
      "timeout_seconds": 900,
      "retry_on_timeout": true,
      "max_retries": 1
    },
    {
      "task_key": "send_completion_notification",
      "description": "Send notification when ETL workflow completes",
      "email_notifications": {
        "on_success": [
          "admin@retailintelligence.com"
        ],
        "on_failure": [
          "admin@retailintelligence.com",
          "data-team@retailintelligence.com"
        ]
      },
      "depends_on": [
        {
          "task_key": "data_quality_checks"
        }
      ]
    }
  ],
  "email_notifications": {
    "on_start": [
      "admin@retailintelligence.com"
    ],
    "on_success": [
      "admin@retailintelligence.com"
    ],
    "on_failure": [
      "admin@retailintelligence.com",
      "data-team@retailintelligence.com"
    ]
  },
  "webhook_notifications": {
    "on_success": {
      "id": "slack-success-webhook"
    },
    "on_failure": {
      "id": "slack-failure-webhook"
    }
  },
  "access_control_list": [
    {
      "user_name": "admin@retailintelligence.com",
      "permission_level": "CAN_MANAGE"
    },
    {
      "group_name": "data-team",
      "permission_level": "CAN_RUN"
    }
  ],
  "run_as": {
    "service_principal_name": "retail-etl-sp@retailintelligence.com"
  },
  "git_source": {
    "git_url": "https://github.com/retailintelligence/databricks-workflows.git",
    "git_branch": "main",
    "git_provider": "gitHub"
  },
  "parameters": [
    {
      "name": "environment",
      "default": "production"
    },
    {
      "name": "data_source_path",
      "default": "/mnt/dbfs/retail_data/raw"
    },
    {
      "name": "mongodb_uri",
      "default": "mongodb+srv://username:password@cluster.mongodb.net/"
    }
  ],
  "tags": {
    "environment": "production",
    "team": "data-engineering",
    "project": "retail-intelligence",
    "cost-center": "analytics"
  },
  "cluster_spec": {
    "new_cluster": {
      "cluster_name": "retail-etl-cluster",
      "spark_version": "13.3.x-scala2.12",
      "node_type_id": "i3.xlarge",
      "driver_node_type_id": "i3.xlarge",
      "num_workers": 0,
      "autoscale": {
        "min_workers": 0,
        "max_workers": 2
      },
      "spark_conf": {
        "spark.sql.extensions": "io.delta.sql.DeltaSparkSessionExtension",
        "spark.sql.catalog.spark_catalog": "org.apache.spark.sql.delta.catalog.DeltaCatalog",
        "spark.databricks.delta.optimizeWrite.enabled": "true",
        "spark.databricks.delta.autoCompact.enabled": "true"
      },
      "custom_tags": {
        "environment": "production",
        "team": "data-engineering"
      }
    }
  }
}
